# Переменные для docker-compose.prod.yml.
# На VPS скопировать в .env (compose подхватывает его автоматически):
#   cp .env.prod.example .env
# Файл содержит пароль БД и НЕ коммитится.

# Postgres в контейнере db
POSTGRES_USER=crm
POSTGRES_PASSWORD=СМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=allyshop

# Адрес API вшивается в бандл фронта при сборке.
# Это тот же домен, что и сайт, плюс /api — фронт и API за одним nginx.
VITE_API_URL=https://allyshop.work/api
