# Backend (production): компилируем TypeScript и запускаем собранный код.
# Локальная разработка использует Dockerfile (nodemon + tsx).
FROM node:22-alpine

WORKDIR /app

# Схему Prisma копируем ДО install — postinstall (prisma generate) её ищет.
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci

COPY . .
RUN npm run build

# devDependencies намеренно оставляем: prisma CLI нужен для migrate deploy,
# tsx — для `npm run seed`.
ENV NODE_ENV=production

EXPOSE 4000

# Миграции применяются при каждом старте контейнера, поэтому схема прод-БД
# всегда соответствует задеплоенному коду.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
