# Прод-окружение бэкенда на VPS.
# Скопировать в backend/.env.production и заполнить. Файл с секретами, не коммитится.
#
# Генерация случайных секретов:
#   openssl rand -hex 48

# База данных — сервис db из docker-compose.prod.yml.
# Пароль и имя БД должны совпадать с POSTGRES_* в корневом .env.
DATABASE_URL="postgresql://crm:ТОТ_ЖЕ_ПАРОЛЬ_ЧТО_В_POSTGRES_PASSWORD@db:5432/allyshop?schema=public"

# Авторизация
JWT_SECRET="СМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ"
JWT_EXPIRES_IN="7d"

# Первый супер-админ (создаётся сидом однократно).
# Обязательно смените пароль — admin/admin в прод недопустим.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="СМЕНИТЕ_ПАРОЛЬ"
SEED_ADMIN_NAME="Администратор"

# Каталог загрузок внутри контейнера — примонтирован на том uploads_data.
UPLOAD_DIR="uploads"

# Сервер
PORT=4000
# Фронт и API на одном домене, поэтому CORS не срабатывает,
# но значение держим строгим на случай обращений с других origin.
CORS_ORIGIN="https://allyshop.work"

# API-ключ Новой Почты (кабинет НП → Настройки → Безопасность → Ключи API).
NOVAPOSHTA_API_KEY=""

# Секрет для cron-эндпоинта /api/cron/refresh-deliveries.
CRON_SECRET="СМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ"
